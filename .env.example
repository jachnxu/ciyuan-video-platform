# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 若使用 systemd 部署，可参照 deploy/ciyuan.service 里的 EnvironmentFile 方式注入

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ciyuan
DB_PASSWORD=your-db-password

# ---------- JWT 签名密钥 ----------
# 务必改成随机长字符串（至少 32 字节），否则任何人都能伪造登录态
# 生成示例：openssl rand -base64 48
CIYUAN_JWT_SECRET=please-change-me-to-a-long-random-string

# ---------- 大模型（DeepSeek，OpenAI 兼容协议） ----------
# 不填也能跑，AI 功能会降级为「按站内热度推荐」
CIYUAN_AI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
